# Optional. Leave both unset to use the zero-setup file store (data/state.json).
#
# Set BOTH to switch the shared game state to Upstash Redis. Required on any
# serverless host (Vercel, Netlify, Cloudflare) where the filesystem is
# ephemeral and per-instance — without it, players will not see each other's
# ticked-off bars. On a single long-running container or VM the file store is
# fine, as long as /data is on a persistent volume.
#
# On Vercel: add Upstash Redis from the Marketplace and these are injected
# automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
